include ../includes/mixins.pug
-
  var pagesLink = [
  {
  home: '/',
  characteristics: './characteristics.html',
  contacts: './contacts.html',
  terrace: './terrace.html',
  about: './about.html',
  404: './404.html'
  }
  ];
block variable
doctype html
html(lang="uk" data-status="local")
  head
    meta(charset='utf-8')
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
    //- Edge и ряд мобильных браузеров слишком умны. Отключим это.
    meta(name='format-detection', content='telephone=no')
    meta(name='format-detection', content='date=no')
    meta(name='format-detection', content='address=no')
    meta(name='format-detection', content='email=no')
    meta(content='notranslate', name='google')
    //- <link rel="apple-touch-icon" sizes="180x180" href="./static/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="./static/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="./static/favicon-16x16.png">
    <link rel="mask-icon" href="./static/safari-pinned-tab.svg">
    <link rel="shortcut icon" href="./static/favicon.ico">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="msapplication-config" content="./static/browserconfig.xml">
    <meta name="theme-color" content="#ffffff">
    block meta
    block head

  body(class= class_page id= id_page)
    script(src='./assets/scripts/immediate-loading.bundle.js')
    // START SVG SPRITE
    include ../../assets/svg-sprite/sprite/symbol_sprite.php
    // END SVG SPRITE
    // START LOADER
    include ../includes/loader.html
    // END LOADER
    // START POPUP MODAL
    include ../includes/popup.pug
    //- include ../includes/form-wrapper.pug
    // END POPUP MODAL
    // START MENU
    include ../includes/menu.pug
    // END MENU

    // -------
    // -------
    // -------
    // -------
    .toast-wrapper(data-toast-wrapper)
    // START HEADER
    block header
    // END HEADER
    +form('data-popup-form')
    .video-popup-wrapper(data-video-popup-wrapper)
      .video-popup
        .video-popup__container
          .video-popup__content
            button.video-popup__close(data-video-popup-wrapper-close)
              svg(width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                path(d="M18 6L6 18" stroke="#fff" stroke-width="1.41167" stroke-miterlimit="10")
                path(d="M6 6L18 18" stroke="#fff" stroke-width="1.41167" stroke-miterlimit="10")
            video(playsinline controls loop poster="./assets/images/home/video-poster.jpg")
              source(src='./assets/images/home/front-screen-video.mp4', type='video/mp4')
    .page__inner(data-scroll-container data-v="1.1")
      .page__content
        block content

      //.page__footer-wrapper
        // START FOOTER
      block footer
        // END FOOTER
    script(defer src='./assets/scripts/common.bundle.js')
    block scripts
