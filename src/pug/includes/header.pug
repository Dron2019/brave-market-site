-
    var header_links = [
        ['Головна', '/'],
        ['Про проєкт', 'about'],
        //- ['Орендарям', '#'],
        //- ['Магазини', '#'],
        ['Новини', 'news'],
        ['Документи', 'documents'],
        ['Контакти', 'contacts'],
    ];

header(class="header "+header_class)
    a(href="/").header__logo
        include ./logo.pug
    .header__links(data-lenis-prevent)
        each val, index in header_links
            a(href=val[1] data-title=val[0]).text-style-nav.color-white.active 
                span #{val[0]}
            if index == 3
                .header-links-dropdown.color-send.text-style-nav
                    .header-links-dropdown-title 
                        span Мапа ринку
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 10L12 15L17 10H7Z" fill="#F3EAE1"/>
                        </svg>
                    ul.header-links-dropdown-list 
                        li 
                            a(href="/for-buyers") Для покупців
                        li 
                            a(href="/for-tenants") Для орендарів
    .header__buttons
        button(type="button" data-form="data-form").header-button-dark
            span Оренда
