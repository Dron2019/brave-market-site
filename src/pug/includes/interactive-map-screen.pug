div.interactive-map-screen(class=interactiveMapClass)
    <div id="miniMap" class="position-fixed mini-map">
        <div id="mapMarker" class="position-absolute mini-map-marker"></div>
    </div>
    .interactive-map-screen__decor-line
    div.color-gold.text-style-auxiliary.interactive-map-screen__subtitle Мапа
    .text-style-h-3.color-graphite.interactive-map-screen__title Інтерактивний план приміщень центрального ринку “Ірпінь”
    .interactive-map-screen__iframe-wrapper(data-infobox-type="standart")
        img(src="./assets/images/home/map-temp.jpg")
    .interactivew-map-screen__decor-line.with-screen-offset.no-margin