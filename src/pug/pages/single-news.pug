
extends ../layout/main
block variable
  -
    var title_page = 'Гарна новина'
    var id_page = 'id-page-single-news'
    var class_page = 'class-page-single-news'
    var breadcrumbsSubitem = [
      {
        label: 'Новини',
        link: '/news'
      }
    ];
    var news = [
      { title: 'Ексклюзивні Знижки на Центральному Ринку Ірпінь', text: 'Завітайте до нашого ринку та насолоджуйтеся ексклюзивними знижками на найпопулярніші товари. Ваші улюблені покупки стали ще доступнішими!', img: 'home/news/1.jpg' },
      { title: 'Ексклюзивні Знижки на Центральному Ринку Ірпінь', text: 'Завітайте до нашого ринку та насолоджуйтеся ексклюзивними знижками на найпопулярніші товари. Ваші улюблені покупки стали ще доступнішими!', img: 'home/news/2.jpg' }
    ]
  
block meta
  title= title_page
  meta(name='description', content='')
block head
    link(rel='stylesheet', href="./assets/styles/main.min.css")
block scripts
  script(defer src='./assets/scripts/vendors.bundle.js')
  script(defer src='./assets/scripts/index.bundle.js')
  script(defer src='./assets/scripts/libs.js')
  script(defer src='./assets/scripts/index.js')
  script(defer src='./assets/scripts/header.js')
  script(defer src='./assets/scripts/single-news.js')
block content
  .single-news-front-screen
    .single-news-front-screen__content
      .single-news-front-screen__date 10.09.2024
      .single-news-front-screen__title ОРЕНДУЙТЕ ПРИМІЩЕННЯ ЗІ ЗНИЖКОЮ В 30%
      img(src="./assets/images/single-news/example.jpg", alt="").single-news-front-screen__img

  .container.single-news-container
    .single-news-container__title.text-style-h-3.color-gold Відкриття відділу продажу ЖК Park House: Новий Етап Сучасного Життя!
    .single-news-container__text.text-style-txt.color-send Ми з радістю оголошуємо про відкриття нового відділу продажу у нашому житловому комплексі Park House у мальовничому місті Кропивницький! Це важливий крок у розвитку нашого проекту, який пропонує неперевершені можливості для сучасного та комфортного життя.
    ul.single-news-container__list
      li Комфортне житло в новобудові зі зручним розташуванням
      li Можливість придбання квартири в розстрочку без відсотків
      li Безкоштовний доступ до фітнес-центру та інших інфраструктурних об'єктів ЖК "Щасливий"
  .container.other-news-container
    .other-news-container__title Останні новини та акції
    each val in news
      a(href="/single-news").news-card.news-card--transparent
          .news-card__content
            .news-card__title Ексклюзивні Знижки на Центральному Ринку Ірпінь
            .news-card__text Завітайте до нашого ринку та насолоджуйтеся ексклюзивними знижками на найпопулярніші товари. Ваші улюблені покупки стали ще доступнішими!
            button(type="button").button-colored
              span Детальніше
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.5415 23.4229L21.8499 12.0012L10.5415 0.578125" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                <path d="M21.8508 12H0.706055" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
              </svg>
          .news-card__img-wrapper
            .news-card__img
              +img(val['img'])
  include ../includes/contact-screen.pug

block footer
  include ../includes/footer.pug

block header
  include ../includes/header.pug
