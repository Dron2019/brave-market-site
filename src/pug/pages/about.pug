extends ../layout/main
block variable
  -
    var title_page = 'Про нас'
    var id_page = 'id-page-about'
    var class_page = 'class-page-about'
    const a = [
        {
            "title": "3 місяці канікул",
            "text": "Для перших 50 орендларів діє ексклюзивна пропозиція"
        },
        {
            "title": "Оренда від 15м2,",
            "text": "Є можливість орендувати: 15м2, 30м2, 60м2, 15м2"
        },
        {
            "title": "Потужний генератор,",
            "text": "Ваш бізнес буде працювати беззупинно"
        },
        {
            "title": "Зупинка для маршруток",
            "text": "Місцеві маршрутки <br> Маршрутки які їдуть на Київ <br> Маршрутка від центрального ринку Ірпінь до мікрорайноів міста які будуть привозити та відвозити мешканців міста"
        },
        {
            "title": "пропозиція для різної категорії бізнесів,",
            "text": "Центральний ринок Ірпеня пропонує широкий асортимент товарів та послуг, включаючи продукти, фаст-фуд, одяг, взуття, білизну, товари для дому, матеріали для ремонту, побутову хімію та різноманітні послуги."
        },
        {
            "title": "500 паркомісць,",
            "text": "Ваш шопінг та відпочинок буде комфортним"
        },
        {
            "title": "щотижнева крафтова ярмарка,",
            "text": "На ринку ви знайдете фаст-фуд, одяг, товари для дому, матеріали для ремонту, побутову хімію та різноманітні послуги"
        },
        {
            "title": "вигідне розташування,",
            "text": "Найбільша набережна Київщини. Об’їзна дорога міста Ірпінь по вулиці Підгірній."
        }
    ]

block meta
    title= title_page
    meta(name='description', content='')
block head
    link(rel='stylesheet', href="./assets/styles/main.min.css")
block scripts
    script(defer src='./assets/scripts/vendors.bundle.js')
    script(defer src='./assets/scripts/about.bundle.js')

block content
    .inner-page-front-screen
        .inner-page-front-screen__content
            .inner-page-front-screen__text
                div.color-gold.inner-page-front-screen__subtitle Про проект
                div.color-send.text-style-h-2.inner-page-front-screen__title Досконалість в кожній деталі
                div.color-send.text-style-txt.inner-page-front-screen__description Ринок Ірпінь" – це сучасний торговельний комплекс, який пропонує розширений вибір товарів на площі 2865 квадратних метрів та налічує 192 торгівельних павільйонів.
                button(type="button" class="button-colored") 
                    span Прокласти маршрут
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M10.542 23.4229L21.8504 12.0012L10.542 0.578125" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                        <path d="M21.8508 12H0.706055" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                    </svg>
                button(type="button" class="button-colored button-colored--transparent") 
                    span Переглянути відео
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 5.14062V19.1406L19 12.1406L8 5.14062Z" fill="#F3EAE1"/>
                    </svg>
            .inner-page-front-screen__img
                img(src="./assets/images/about/front-screen.jpg", alt="")
    .about-screen2
        .about-screen2__grid
            each val,index in a
                if index == 4
                    .about-screen2__grid-center-item
                        .text-style-auxiliary.color-gold Переваги
                        .about-screen2__grid-center-item-title центрального ринку Ірпінь
                        include ./about/about-logo.svg
                .about-screen2__grid-item
                    .about-screen2__grid-item-title.text-style-h-4.color-gold=val['title']
                    .about-screen2__grid-item-text.text-style-txt.color-graphite !{val['text']}
    include ../includes/contact-screen.pug
block footer
    include ../includes/footer.pug

block header
    include ../includes/header.pug