block meta
    title= title_page
    meta(name='description' content='')
block head
    link(rel='stylesheet' href="./assets/styles/main.min.css")
block scripts
    script(defer src='./assets/scripts/vendors.bundle.js')
    script(defer src='./assets/scripts/location.bundle.js')
block content
    .inner-page-front-screen
        .inner-page-front-screen__content
            .inner-page-front-screen__text
                div.color-gold.inner-page-front-screen__subtitle Графік руху
                div.color-send.text-style-h-2.inner-page-front-screen__title розклад автобусів
                div.color-send.text-style-txt.inner-page-front-screen__description Дізнайтеся, як зручно дістатися до нашого ринку різними видами транспорту. Перегляньте маршрути, розклад руху та доступні варіанти громадського транспорту.
                a(target='_blank' type="button" class="button-colored" href="https://www.google.com/maps/dir//%D0%B2%D1%83%D0%BB%D0%B8%D1%86%D1%8F+%D0%9F%D1%96%D0%B4%D0%B3%D1%96%D1%80%D0%BD%D0%B0,+%D0%86%D1%80%D0%BF%D1%96%D0%BD%D1%8C,+%D0%9A%D0%B8%D1%97%D0%B2%D1%81%D1%8C%D0%BA%D0%B0+%D0%BE%D0%B1%D0%BB%D0%B0%D1%81%D1%82%D1%8C/@50.5126895,30.2432543,15z/data=!3m1!4b1!4m8!4m7!1m0!1m5!1m1!1s0x472b33c976ed30eb:0xbbb752ac7aa526de!2m2!1d30.253554!2d50.5126763?entry=ttu") 
                    span Побудувати маршрут
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M10.542 23.4229L21.8504 12.0012L10.542 0.578125" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                        <path d="M21.8508 12H0.706055" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                    </svg>
            .inner-page-front-screen__img
                img(src="./assets/images/for-tenants/front-bg.jpg", alt="")
    .location-screen
        .location-screen-container
            each val in routes
                .location-screen__item
                    .location-screen__item-title 
                        span.color-gold #{val['title1']} 
                        span.color-graphite #{val['title2']}
                    .location-screen__item-img
                        img(src=val['img'] alt="")
                    .location-screen__item-text
                        each scheldule in val['list']
                            .location-screen__item-part
                                .location-screen__item-part-title #{scheldule['title']}
                                .location-screen__item-part-list
                                    each point in scheldule['points']
                                        .location-screen__item-part-list-item #{point}
                        if val['description']
                            .location-screen__item-description
                                p #{val['description']}
                                if val['description2']
                                    p !{val['description2']}
    include ../includes/contact-screen.pug
block footer
    include ../includes/footer.pug

block header
    include ../includes/header.pug
