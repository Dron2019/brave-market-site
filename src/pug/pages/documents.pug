          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="64" height="64" transform="translate(64) rotate(90)" fill="#C0A46F"/>
            <g clip-path="url(#clip0_1520_2145)">
            <path d="M32.5554 19.5L32.5554 39.5M32.5554 39.5L22.0003 29.5M32.5554 39.5L42 29.5" stroke="#28282A" stroke-width="2"/>
            <rect x="21" y="43" width="22" height="2" fill="#28282A"/>
            </g>
            <defs>
            <clipPath id="clip0_1520_2145">
            <rect width="27" height="24" fill="white" transform="translate(44 18.5) rotate(90)"/>
