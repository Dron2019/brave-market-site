
extends ../layout/main
block variable
  -
    var title_page = 'Документи'
    var id_page = 'id-page-documents'
    var class_page = 'class-page-documents'
    var breadcrumbsSubitem = [
    ]
  
block meta
  title= title_page
  meta(name='description', content='')
block head
    link(rel='stylesheet', href="./assets/styles/main.min.css")
block scripts
    script(defer src='./assets/scripts/vendors.bundle.js')
    script(defer src='./assets/scripts/documents.bundle.js')
block content
  .inner-page-front-screen
      .inner-page-front-screen__content
          .inner-page-front-screen__text
              div.color-gold.inner-page-front-screen__subtitle документація
              div.color-send.text-style-h-2.inner-page-front-screen__title документи та дозволи
              div.color-send.text-style-txt.inner-page-front-screen__description Знайдіть всі необхідні сертифікати та дозвільні документи, що підтверджують якість і безпеку продукції, представленої на нашому ринку.
              button(type="button" class="button-colored") 
                  span Оренда
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <path d="M10.542 23.4229L21.8504 12.0012L10.542 0.578125" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                      <path d="M21.8508 12H0.706055" stroke="#28282A" stroke-width="1.41167" stroke-miterlimit="10"/>
                  </svg>
          .inner-page-front-screen__img
              img(src="./assets/images/docs/front-bg.jpg", alt="")
  .container.documents-container
    .documents-container__content
      .doc-card 
        .doc-card__title Сертифікати відповідності
        .doc-card__date 01.01.2024
